# Copia estos valores a tu entorno local. Son ficticios: nunca uses secretos reales en el repositorio.

# Puerto HTTP del backend (1-65535)
PORT=3000

# Secreto para firmar JWT (HS256). Mínimo 32 caracteres.
JWT_SECRET=cambia-por-un-secreto-de-al-menos-32-caracteres

# Emisor y audiencia esperados en el token
JWT_ISSUER=kynwallet-backend
JWT_AUDIENCE=kynwallet-web

# Vigencia del token en segundos (máximo 900)
JWT_EXPIRES_IN_SECONDS=900

# Latencia simulada de las respuestas mock, en milisegundos (0-4500)
SIMULATED_LATENCY_MS=1000

# Cuentas de demostración en JSON. Las contraseñas se guardan como hash scrypt.
# Hash de ejemplo para la contraseña "ejemplo-password-largo-1".
DEMO_ACCOUNTS=[{"email":"demo@kynwallet.test","displayName":"Titular Demo","passwordHash":"scrypt$16384$8$1$GPOpzXQn8QmTrf4Oc3xazw==$hPuywM3pLOSGTATB3KH4kRQ9qtTLxf2tq65RargOmXdk2lQl33ig5/5RfPSpAIySOD5SoYd2wwPOc1KWoQwvXA=="}]
